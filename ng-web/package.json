    "angular-eslint": "22.5.0",
    "autoprefixer": "10.6.1",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "jsdom": "30.1.2",
    "postcss": "8.5.29",
    "prettier": "3.9.9",
