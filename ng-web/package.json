    "@angular/forms": "22.2.1",
    "@angular/platform-browser": "22.2.1",
    "@angular/router": "22.2.1",
    "@jsverse/transloco": "8.4.0",
    "@openng/icons": "1.0.0",
    "@openng/optimus-ui": "2.0.2",
    "@openng/optimus-ui-tailwindcss": "2.0.2",
    "@openng/optimus-ui-themes": "2.0.2",
