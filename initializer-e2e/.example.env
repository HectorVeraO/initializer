# Env template for initializer-e2e. Copy to .env and fill the values. .env is NEVER committed.
# In CI the real values come from repository secrets that .github/workflows/e2e.yml writes into .env.

# === ng-web (Angular 22) ===
# Local dev server: http://localhost:10120
# QA/staging: set the real deployed front URL.
INIT_WEB_BASE_URL=http://localhost:10120
# Optional: the login route, if your app has one (used by buildWebLoginUrl).
INIT_WEB_LOGIN_PATH=

# === Test credentials (add the ones your real tests need) ===
INIT_USER_EMAIL=
INIT_USER_PASSWORD=

# === Timeouts (ms) ===
INIT_DEFAULT_TIMEOUT=30000
INIT_NAV_TIMEOUT=30000
INIT_ACTION_TIMEOUT=10000

# === Reporting ===
PW_HTML_REPORT_DIR=playwright-report
PW_RESULTS_DIR=test-results

# === Evidence artifacts ===
# video:      off | on | retain-on-failure | on-first-retry
# screenshot: off | on | only-on-failure
# trace:      off | on | retain-on-failure | on-first-retry
# Local (the values below): on / on / on, full capture of every run.
# CI: leave these unset. The code defaults are retain-on-failure / only-on-failure /
# on-first-retry, and the e2e workflow writes none of them into .env.
PW_VIDEO=on
PW_SCREENSHOT=on
PW_TRACE=on
# Browser viewport AND video size (always equal). Default 1600x900. For full-HD
# evidence raise both to 1920x1080; the file grows ~1.8x.
INIT_VIEWPORT_WIDTH=1600
INIT_VIEWPORT_HEIGHT=900

# === @manual exclusion override ===
# Unset (the default): @manual tests are excluded from every run. Set it for ONE
# invocation to lift or replace the exclusion; never leave it set here, because an
# empty value in .env disables the exclusion for every run.
#   bash:       INIT_TEST_GREP_INVERT= npx playwright test tests/e2e/x.spec.ts
#   PowerShell: $env:INIT_TEST_GREP_INVERT='none'; npx playwright test tests/e2e/x.spec.ts; Remove-Item Env:INIT_TEST_GREP_INVERT
# Empty or `none` disables the exclusion (PowerShell deletes a variable set to ''); any
# other value is used as the grepInvert regex.
# INIT_TEST_GREP_INVERT=

# === Parallelism ===
PLAYWRIGHT_WORKERS=2
