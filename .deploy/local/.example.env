# Copy to .deploy/local/.env (gitignored) before `docker compose up -d`.
INITIALIZER_PG_PASSWORD=change-me-local-only
KRATOS_PG_PASSWORD=change-me-local-only-kratos

# go-srv (host-dev): load with `set -a; . .deploy/local/.env; set +a`.
GO_SRV_ADDR=:10100
GATBASE_PUBLIC_BASE_URL=http://localhost:10120
GATBASE_DATABASE_URL="postgres://initializer:${INITIALIZER_PG_PASSWORD}@localhost:10132/initializer?sslmode=disable"
OTEL_SERVICE_NAME=go-srv

# core-auth. 43 `A` is a 32-byte zero seed, local only; generate a real one with
# `openssl rand -base64 32 | tr '+/' '-_' | tr -d '='`.
GATBASE_SESSION_KEYS=local-dev-1:passphrase:change-me-local-only-session-key
GATBASE_BOOTSTRAP_TENANT_SLUG=acme
GATBASE_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
GATBASE_BOOTSTRAP_ADMIN_PASSWORD=change-me-local-only
GATBASE_KRATOS_PUBLIC_URL=http://127.0.0.1:10133
GATBASE_KRATOS_ADMIN_URL=http://127.0.0.1:10134
