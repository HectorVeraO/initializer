# Copy to .deploy/local/.env (gitignored) before `docker compose up -d`.
INITIALIZER_PG_PASSWORD=change-me-local-only

# go-srv (host-dev): load with `set -a; . .deploy/local/.env; set +a`.
# Loopback only: a host-dev listener on every interface makes Windows ask for a firewall rule on each new build.
GO_SRV_ADDR=127.0.0.1:10100
APP_PUBLIC_BASE_URL=http://localhost:10120
APP_DATABASE_URL="postgres://initializer:${INITIALIZER_PG_PASSWORD}@localhost:10132/initializer?sslmode=disable"
OTEL_SERVICE_NAME=go-srv

# initializer:module identity
# identity: Kratos database password (compose) and the go-srv session, bootstrap and Kratos keys.
# The `passphrase:` entry derives a local-only signing key and is
# rejected under an https public URL; outside local use a generated seed:
# `openssl rand -base64 32 | tr '+/' '-_' | tr -d '='`.
KRATOS_PG_PASSWORD=change-me-local-only-kratos
APP_SESSION_KEYS=local-dev-1:passphrase:change-me-local-only-session-key
APP_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
APP_BOOTSTRAP_ADMIN_PASSWORD=change-me-local-only
APP_KRATOS_PUBLIC_URL=http://127.0.0.1:10133
APP_KRATOS_ADMIN_URL=http://127.0.0.1:10134
# initializer:end identity

# initializer:module tenancy
# tenancy: the first tenant, created for the bootstrap operator while no tenant exists.
APP_BOOTSTRAP_TENANT_SLUG=acme
# initializer:end tenancy

# initializer:module feature-flags
# feature-flags: manifest read at startup (required when the module is installed).
# Relative paths resolve against the working directory; host-dev runs from go-srv/.
APP_FLAGS_FILE=../flags.yaml
# initializer:end feature-flags
