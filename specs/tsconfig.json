{
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "ES2023",
    "lib": ["ES2023"],
    "types": ["node"],
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "resolveJsonModule": true,
    "noEmit": true
  },
  "include": ["playwright.config.ts", "tck-support/**/*.ts", "*/tck/**/*.ts"],
  "exclude": ["node_modules", "test-results", "playwright-report", "scripts"]
}
