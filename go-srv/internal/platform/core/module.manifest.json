    { "path": ".deploy/local/.example.env", "text": "%{envPrefix}_PG_PASSWORD=" },
    { "path": ".deploy/local/.example.env", "text": "postgres://%{dbUser}:${%{envPrefix}_PG_PASSWORD}@localhost:10132/%{database}?" },
    { "path": ".deploy/local/README.md", "text": "`%{service.postgres}`" },
    { "path": ".deploy/local/README.md", "text": "`%{service.kratos}` public API" },
    { "path": ".deploy/local/README.md", "text": "`%{service.kratos}` admin API" },
    { "path": ".deploy/local/README.md", "text": "`%{service.postgres-init}` runs on every" },
    { "path": ".deploy/local/README.md", "text": "`%{service.kratos-migrate}` applies the Kratos migrations before `%{service.kratos}` starts" }
  ]
