{
  "schema": 1,
  "stack": "go-srv",
  "module": "core",
  "version": "0.1.0",
  "implied": true,
  "implementsSpec": { "core": "0.1.0" },
  "requiresModules": [],
  "tablePrefixes": ["cor"],
  "files": [
    ".deploy/local/",
    ".gitattributes",
    ".gitignore",
    "go-srv/",
    "mise.toml",
    "specs/.gitignore",
    "specs/package-lock.json",
